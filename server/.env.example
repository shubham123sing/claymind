# ClayMind game agent backend (server/agents). Copy to .env (git-ignored); never commit real keys.
# Free Groq models (chain in agents/providers.json) and the prompt-guard model use this key.
GROQ_API_KEY=

# Optional
# CLAYMIND_AGENTS_PORT=8790
# CLAYMIND_AGENTS_HOST=127.0.0.1
# CLAYMIND_ORIGINS=http://localhost:5190,https://localhost:8081,https://shubham123sing.github.io
# CLAYMIND_RATE_PER_MIN=30
# CLAYMIND_LLM_TIMEOUT_S=12
# CLAYMIND_WEB=1            # 0 = never search the web (built-in games and cached Rule Cards only)
# A2A_MODE=local            # local = A2A over HTTP on this server, inproc = direct calls
# A2A_TOKEN=                # shared token for the internal A2A routes (random per start if unset)
# CLAYMIND_TLS_CERT= / CLAYMIND_TLS_KEY=   # serve HTTPS
# CLAYMIND_FAKE_LLM=1       # tests: canned answers, no network
