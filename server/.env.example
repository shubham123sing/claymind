# ClayMind AI server configuration. Copy to .env (never commit real keys).
# Providers: mock (default, free, offline) | anthropic (VLM) | fal (image / 3D) | none
VLM_PROVIDER=mock
IMAGE_PROVIDER=mock
MODEL_PROVIDER=mock

# Claude vision (VLM_PROVIDER=anthropic). Key from ANTHROPIC_API_KEY or `ant auth login`.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# fal.ai (IMAGE_PROVIDER / MODEL_PROVIDER=fal). Verify model ids on fal.ai first.
# FAL_KEY=
FAL_3D_MODEL=fal-ai/trellis
FAL_IMAGE_MODEL=fal-ai/flux/dev/image-to-image

# Guards
SPEND_CAP_USD=5
SESSION_DESCRIBE_LIMIT=40
SESSION_GENERATE_LIMIT=8
COST_VLM_USD=0.02
COST_IMAGE_USD=0.03
COST_MODEL_USD=0.10
CORS_ORIGINS=https://localhost:8081,http://localhost:5190,http://localhost:5191
